# Backend Environment Variables
# Copy this file to .env and fill in the values

# Database (Neon / Vercel integration: pooled & unpooled)
DATABASEV2_DATABASE_URL="postgresql://user:password@host:5432/recall?schema=public"
DATABASEV2_DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/recall?schema=public"

# Vapi
VAPI_API_KEY="your-vapi-api-key"
VAPI_SERVER_SECRET="your-vapi-server-secret"

# Clerk
CLERK_SECRET_KEY="your-clerk-secret-key"

# CORS — comma-separated list of allowed frontend origins
# Example: "https://recall-frontend.vercel.app,https://recall-frontend-git-feat-xxx.vercel.app"
ALLOWED_ORIGINS="http://localhost:5173"

# Server
PORT=3001
NODE_ENV=development

# Security / Multi-tenancy
# Yalnızca local geliştirmede true yapılmalı; production ortam değişkenlerinde (Vercel vb.) ASLA tanımlanmamalıdır.
ALLOW_DEV_CLINIC_FALLBACK=false

# Sentry Error Tracking (Opsiyonel / Production)
# Sentry.io Node.js projenizin DSN adresi. Boş bırakılırsa veya geçersizse hata izleme devre dışı kalır.
SENTRY_DSN=""
