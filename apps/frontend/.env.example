# Frontend Environment Variables
# Copy this file to .env and fill in the values

# Clerk
VITE_CLERK_PUBLISHABLE_KEY="your-clerk-publishable-key"

# Backend API (Boş bırakılırsa development modunda http://localhost:3001, production'da /api proxy kullanılır)
VITE_API_BASE_URL="http://localhost:3001"

# Sentry Error Tracking (Opsiyonel / Production)
# Sentry.io React projenizin Client DSN adresi.
VITE_SENTRY_DSN=""
